@str_set(buf: ptr<int>, pos: int, val: int) {
  ptr: ptr<int> = ptradd buf pos;
  store ptr val;
}

@IO_out_string(self: ptr<int>, str: ptr<int>) {
  one: int = const 1;
  len: int = load str;
  idx_i: int = const 0;
.loop_out:
  cond: bool = lt idx_i len;
  br cond .body_out .end_out;
.body_out:
  idx: int = add idx_i one;
  ptr_p: ptr<int> = ptradd str idx;
  ascii: int = load ptr_p;
  print ascii;
  idx_i: int = add idx_i one;
  jmp .loop_out;
.end_out:
}

